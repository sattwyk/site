---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white text-lg">
      hi, i'm satty <span class="hello-mark" aria-hidden="true">✳︎</span>
    </h4>

    <div class="space-y-16 mt-8">
      <!-- About / Intro -->
      <section>
        <article class="space-y-4">
          <p class="animate leading-relaxed">
            i'm a software engineer interested in backend and distributed systems. i like figuring
            out how they behave when things fail.
          </p>

          <p class="animate leading-relaxed">
            currently, i'm building <Link
              href="https://github.com/sattwyk/adversary"
              external
              aria-label="Adversary, a deterministic simulation testing harness"
            >
              adversary
            </Link>, a deterministic simulation testing harness in rust and webassembly.
          </p>

          <p class="animate leading-relaxed">
            i build things to understand them, and write about the parts that make me stop and
            think.
          </p>

          <p class="animate leading-relaxed">
            away from code, i cook and read philosophy, especially <Link
              href="https://www.conjectureinstitute.org/glossary#critical-rationalism"
              external
              aria-label="Critical Rationalism"
            >
              critical rationalism
            </Link>.
          </p>
        </article>
      </section>
      <!-- Latest Posts -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">writing</h5>
          <Link href="/blog"> see all posts </Link>
        </div>
        <ul class="writing-list flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Recent Projects -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">projects</h5>
          <Link href="/projects"> see all projects </Link>
        </div>
        <ul class="writing-list flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Social / Contact -->
      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">say hello</h5>
        <article>
          <p class="leading-relaxed">if something here interests you, i'd like to hear from you.</p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                  {SOCIAL.NAME}
                </Link>
                {"/"}
              </li>
            ))
          }
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
