---
import type { CollectionEntry } from "astro:content";
type Props = { entry: CollectionEntry<"blog"> | CollectionEntry<"projects"> };
const { entry } = Astro.props;
const href = `/${entry.collection}/${entry.id}`;
const date = entry.data.date;
---

<a href={href} class="writing-row">
  <span
    ><span class="row-title">{entry.data.title}</span><span class="row-description"
      >{entry.data.description}</span
    ></span
  >
  <time datetime={date.toISOString()}
    >{date.toLocaleDateString("en-GB", { day: "2-digit", month: "short" })}</time
  >
</a>
